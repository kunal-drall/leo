# Mezo Network Configuration
# Testnet
NEXT_PUBLIC_MEZO_TESTNET_RPC_URL=https://rpc.test.mezo.org
NEXT_PUBLIC_MEZO_TESTNET_CHAIN_ID=31611

# Mainnet
NEXT_PUBLIC_MEZO_MAINNET_RPC_URL=https://rpc-http.mezo.boar.network
NEXT_PUBLIC_MEZO_MAINNET_CHAIN_ID=31612

# WalletConnect (Get your Project ID from https://cloud.walletconnect.com)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_project_id_here

# Official MUSD Contract Addresses
NEXT_PUBLIC_MUSD_ADDRESS_MAINNET=0xdD468A1DDc392dcdbEf6db6e34E89AA338F9F186
NEXT_PUBLIC_MUSD_ADDRESS_TESTNET=0x118917a40FAF1CD7a13dB0Ef56C86De7973Ac503

# Your Deployed Contract Addresses (will be auto-populated by deployment script)
