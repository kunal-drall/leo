# Mezo Network Configuration
MEZO_TESTNET_RPC_URL=https://testnet-rpc.mezo.org
MEZO_TESTNET_CHAIN_ID=686868
MEZO_EXPLORER_URL=https://explorer.mezo.org
MEZO_EXPLORER_API_URL=https://explorer-api.mezo.org

# Deployment
PRIVATE_KEY=your_private_key_here

# Contract Addresses (fill after deployment)
MUSD_CONTRACT_ADDRESS=
CIRCLE_FACTORY_ADDRESS=
TRUST_SCORE_ADDRESS=
INSURANCE_POOL_ADDRESS=
YIELD_MANAGER_ADDRESS=
MUSD_INTEGRATION_ADDRESS=

# Optional
MEZO_API_KEY=your_api_key_for_verification
REPORT_GAS=false

# Frontend Environment Variables (for frontend/.env.local)
NEXT_PUBLIC_MEZO_TESTNET_RPC_URL=https://testnet-rpc.mezo.org
NEXT_PUBLIC_MEZO_TESTNET_CHAIN_ID=686868
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id
