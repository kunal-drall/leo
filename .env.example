# Mezo Network Configuration
# Testnet (Official)
MEZO_TESTNET_RPC_URL=https://rpc.test.mezo.org
MEZO_TESTNET_CHAIN_ID=31611

# Mainnet (Official - multiple RPC options available)
MEZO_MAINNET_RPC_URL=https://rpc-http.mezo.boar.network
# Alternative RPCs:
# - https://rpc_evm-mezo.imperator.co
# - https://mainnet.mezo.public.validationcloud.io
MEZO_MAINNET_CHAIN_ID=31612

# Deployment
PRIVATE_KEY=your_private_key_here

# Real MUSD Contract Addresses (Official Mezo)
MUSD_CONTRACT_ADDRESS_MAINNET=0xdD468A1DDc392dcdbEf6db6e34E89AA338F9F186
MUSD_CONTRACT_ADDRESS_TESTNET=0x118917a40FAF1CD7a13dB0Ef56C86De7973Ac503

# Your Deployed Contract Addresses (fill after deployment)
CIRCLE_FACTORY_ADDRESS=
TRUST_SCORE_ADDRESS=
INSURANCE_POOL_ADDRESS=
YIELD_MANAGER_ADDRESS=
MUSD_INTEGRATION_ADDRESS=

# Optional
MEZO_API_KEY=your_api_key_for_verification
REPORT_GAS=false

# Frontend Environment Variables (for frontend/.env.local)
NEXT_PUBLIC_MEZO_TESTNET_RPC_URL=https://rpc.test.mezo.org
NEXT_PUBLIC_MEZO_TESTNET_CHAIN_ID=31611
NEXT_PUBLIC_MEZO_MAINNET_RPC_URL=https://rpc-http.mezo.boar.network
NEXT_PUBLIC_MEZO_MAINNET_CHAIN_ID=31612
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=your_walletconnect_project_id

# Native Currency on Mezo is BTC (18 decimals)
